# ── Required ────────────────────────────────────────────────
# Qloo Taste AI (hackathon key)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Amazon Bedrock. Use an IAM user/role limited to bedrock:InvokeModel and bedrock:Converse.
# On EC2, prefer an instance role and leave the two keys empty.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2

# ── Optional fallbacks (used only if Bedrock fails) ─────────
OPENROUTER_API_KEY=
GEMINI_API_KEY=

# ── Server ──────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
# Dev only: where the Vite dev server runs (CORS)
FRONTEND_URL=http://localhost:5173

# ── Abuse protection for a public demo ──────────────────────
LIVE_RUNS_PER_IP_PER_HOUR=6
LIVE_RUNS_PER_DAY=40
BRIEF_PARSES_PER_IP_PER_HOUR=30
