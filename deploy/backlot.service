[Unit]
Description=Backlot (API + built frontend)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=backlot
WorkingDirectory=/opt/backlot/backend
EnvironmentFile=/opt/backlot/backend/.env
Environment=NODE_ENV=production
Environment=PORT=3001
# Set here as well: values in EnvironmentFile override Environment= lines above
ExecStart=/usr/bin/env NODE_ENV=production PORT=3001 /usr/bin/npm start
Restart=always
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/backlot/backend/preset-cache

[Install]
WantedBy=multi-user.target
